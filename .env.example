# --- Required ---
DATABASE_URL=postgres://postgres:postgres@localhost:5433/ecommerce26
# DATABASE_URL_UNPOOLED=        # Neon direct URL, used by migrations if set
# DATABASE_SSL=true             # set for Neon / hosted Postgres
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (Razorpay). Missing => checkout offers COD only ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shipping (Shiprocket). Missing => flat-rate shipping from Admin > Settings ---
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_TOKEN=

# --- Address search (Google Places API New). Missing => search box hidden ---
GOOGLE_MAPS_API_KEY=

# --- Google Sign-In. Missing => button hidden ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Email (Resend). Missing => emails printed to the server log ---
RESEND_API_KEY=
EMAIL_FROM="Wax Studio <orders@example.com>"
SHOP_NOTIFY_EMAIL=

# --- Cron ---
CRON_SECRET=change-me

# --- Images: Cloudinary, or STORAGE_DRIVER=s3 with S3_*; missing => local /public/uploads (dev only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# STORAGE_DRIVER=s3
# S3_ENDPOINT=  S3_BUCKET=  S3_ACCESS_KEY_ID=  S3_SECRET_ACCESS_KEY=  S3_PUBLIC_URL=

# --- Analytics (all optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_PINTEREST_VERIFY=

# --- Order numbers ---
ORDER_PREFIX=WAX
